{
  "name": "crswd-axi",
  "version": "0.1.0",
  "description": "Agent-ergonomic CLI over crswd's six signed session routes: list, show, create, prompt, output, close",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/craig-ai-tooling/crswd-axi.git"
  },
  "keywords": [
    "axi",
    "agent",
    "cli",
    "toon",
    "crswd",
    "claude-code",
    "tmux"
  ],
  "bin": {
    "crswd-axi": "bin/crswd-axi.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "test": "vitest run",
    "skill:gen": "node scripts/gen-skill.mjs",
    "skill:check": "node scripts/gen-skill.mjs --check"
  },
  "dependencies": {
    "axi-sdk-js": "^0.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
